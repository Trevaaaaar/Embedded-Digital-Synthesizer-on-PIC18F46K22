        __delay_ms(20);
        wave_type_index = (wave_type_index + 1) % 4;
        
        while(!PORTCbits.RC1);
        __delay_ms(20);
        }

        if (!PORTDbits.RD0){ //D0 button controls env_level
            __delay_ms(20);
            note_on(3);
            while(!PORTDbits.RD0){                }
            note_off();
            __delay_ms(20);
        }

    }
}

void __interrupt() ISR(void){
    uint16_t sample_val = 0;
    uint16_t dac_output = 0; //volume
    
    if (PIR1bits.TMR2IF){
        PIR1bits.TMR2IF = 0;    //Clear tmr2 interrupt flag
        //DDS step 1: advance phase by phase increment
        phase_accum += phase_incr;
        
        //DDS step 2: assign wave sample value
        sample_val = assign_sample_val(phase_accum, wave_type_index);
        
        env_counter++;
        if (env_counter >= env_slow_factor){
            env_counter = 0;
            envelope_update();
        }
        
        // *** VOLUME CHANGE ***
        int32_t centered = (int32_t)sample_val - 2048;  // Convert DAC sample from 0-4095 range to centered range.
        int32_t scaled = centered * volume >> 8;        // volume is 0-255, so shifting right by 8 divides by 256.
        int32_t enveloped_vol = scaled * env_level >> 8;
        dac_output = (uint16_t)(2048 + enveloped_vol);        // Shift signal back to DAC range.
        
        //DDS step 3: send sample to DAC
        mcp4822_write(DAC_CHAN_A, GAIN_1X, dac_output);
    }
}
