void mcp4822_write(uint8_t channel, uint8_t gain, uint16_t code){
    // Build 16-bit command word
    // Bit 15:   channel select (0=A, 1=B)
    // Bit 14:   don't care (0)
    // Bit 13:   /GA gain (0=2x, 1=1x)
    // Bit 12:   /SHDN (1=active)
    // Bits 11-0: 12-bit data
    uint16_t cmd = 0;
    cmd |= ((uint16_t)(channel & 0x01)) << 15;  // Set CHA or CHB
    cmd |= ((uint16_t)(gain    & 0x01)) << 13;  // Set GAIN
    cmd |= (1u << 12);                          // /SHDN = 1 (active)
    cmd |= (code & 0x0FFF);                     // 

    CS_PIN = 0;                                 // assert /CS
    
    SSPBUF = (uint8_t)(cmd >> 8); //Send high byte of SPI command
    while(!SSPSTATbits.BF);         //Wait till done sending
    (void)SSPBUF;                   //Clears SSPSTATbits.BF by reading the received data (which we ignore)
    SSPBUF = (uint8_t)(cmd & 0xFF); //Send low byte of SPI command
    while(!SSPSTATbits.BF);         
    (void)SSPBUF;
    
    CS_PIN = 1;                                 // deassert /CS — latches output
}
void mcp4822_set_mv(uint8_t channel, uint16_t millivolts){
    // Clamp to 4095 max (just under 4096 mV with 2x gain)
    if (millivolts > 4095) millivolts = 4095;
    mcp4822_write(channel, GAIN_1X, (uint16_t)millivolts);
}

void SPI_init(void){
    SCK_TRIS = 0;   // SCK
    SDO_TRIS = 0;   // SDO
    SDI_TRIS = 1;   // SDI
    CS_TRIS = 0;            // CS

    CS_PIN = 1;     // CS idle high
    
    SSPSTATbits.SMP = 0;    //Sample the input at middle of data output time
    SSPSTATbits.CKE = 1;    //Transmit occurs on active->idle clock state (high->low)

    SSPCON1bits.CKP  = 0;   //Idle state for clock is low level
    SSPCON1bits.SSPM = 0b0010;   // Master, Fosc/64 = 1MHz
    SSPCON1bits.SSPEN = 1;  //Enable serial port (SCK,SDO,SDI)
}

//==============================================
void timer2_init(void){
    INTCONbits.GIE = 1;     // Enable global interrupts
    INTCONbits.PEIE = 1;    // Enable peripheral interrupts
    PIE1bits.TMR2IE = 1;    // Enable TMR2 interrupts
    
    PIR1bits.TMR2IF = 0;    // Clear TMR2 flag
    T2CONbits.TMR2ON = 0;   // Turn off TMR2 while configuring
    TMR2 = 0;               // Clear TMR2
    /*
       Fosc = 64 MHz
       Instruction clock = Fosc / 4 = 16 MHz
       Timer tick with prescaler 16 = 1 us

       For 10 kHz sample rate: sample period = 100 us
       Timer2 period = (PR2 + 1) * prescaler * instruction_cycle
                    = (99 + 1) * 16 * 62.5 ns = 100us
    */
    PR2 = 99;
    T2CONbits.T2CKPS = 0b10;    //prescale 1:16
    T2CONbits.T2OUTPS = 0b0000; //postscale 1:1
    T2CONbits.TMR2ON = 1;       //start timer2
}
//==============================================
void note_on(uint8_t note_index){
    phase_incr = note_phase_incr[note_index]; // Set the pitch of the note
    phase_accum = 0;                          // Restart waveform from beginning
    //env_level = 0;                            // Start envelope at silence
    env_state = ENV_ATTACK;                   // Start attack mode
}
void note_off(void){
    env_state = ENV_RELEASE;    //Begin fade-out
}
void envelope_update(void){
    switch(env_state){

        case ENV_ATTACK:
            if (env_level + attack_step >= 255){
                env_level = 255;
                env_state = ENV_DECAY;
            } else {
                env_level += attack_step;
            }
            break;

        case ENV_DECAY:
            if (env_level <= sustain_level + decay_step){
                env_level = sustain_level;
                env_state = ENV_SUSTAIN;
            } else {
                env_level -= decay_step;
            }
            break;

        case ENV_SUSTAIN:
            env_level = sustain_level;
            break;

        case ENV_RELEASE:
            if (env_level <= release_step){
                env_level = 0;
                env_state = ENV_IDLE;
            } else {
                env_level -= release_step;
            }
            break;

        case ENV_IDLE:
        default:
            env_level = 0;
            break;
    }
}
