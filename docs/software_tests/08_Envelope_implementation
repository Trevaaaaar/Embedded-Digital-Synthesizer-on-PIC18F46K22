// Envelope stuff
#define ENV_IDLE     0
#define ENV_ATTACK   1
#define ENV_DECAY    2
#define ENV_SUSTAIN  3
#define ENV_RELEASE  4

volatile uint8_t env_level = 0;        // 0=silent, 255=full volume
volatile uint8_t env_state = ENV_IDLE; // current envelope stage

