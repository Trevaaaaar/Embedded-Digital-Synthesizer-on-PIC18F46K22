/*SPI Stuff*/
#define CS_PIN      LATCbits.LATC2
#define CS_TRIS     TRISCbits.TRISC2
#define SCK_TRIS    TRISCbits.TRISC3
#define SDI_TRIS    TRISCbits.TRISC4
#define SDO_TRIS    TRISCbits.TRISC5

// MCP4822 channel select bit (bit 15 of the 16-bit command word)
#define DAC_CHAN_A  0
#define DAC_CHAN_B  1
#define GAIN_2X     0   // bit=0 ? 2x gain
#define GAIN_1X     1   // bit=1 ? 1x gain

void mcp4822_write(uint8_t channel, uint8_t gain, uint16_t code){
    // Build 16-bit command word
    // Bit 15:   channel select (0=A, 1=B)
    // Bit 14:   don't care (0)
    // Bit 13:   /GA gain (0=2x, 1=1x)
    // Bit 12:   /SHDN (1=active)
    // Bits 11-0: 12-bit data
    uint16_t cmd = 0;
    cmd |= ((uint16_t)(channel & 0x01)) << 15;  // Set CHA or CHB
    cmd |= ((uint16_t)(gain    & 0x01)) << 13;  // Set GAIN
    cmd |= (1u << 12);                          // /SHDN = 1 (active)
    cmd |= (code & 0x0FFF);                     // 

    CS_PIN = 0;                                 // assert /CS
    
    SSPBUF = (uint8_t)(cmd >> 8); //Send high byte of SPI command
    while(!SSPSTATbits.BF);         //Wait till done sending
    (void)SSPBUF;                   //Clears SSPSTATbits.BF by reading the received data (which we ignore)
    SSPBUF = (uint8_t)(cmd & 0xFF); //Send low byte of SPI command
    while(!SSPSTATbits.BF);         
    (void)SSPBUF;
    
    CS_PIN = 1;                                 // deassert /CS ? latches output
}
void SPI_init(void){
    SCK_TRIS = 0;   // SCK
    SDO_TRIS = 0;   // SDO
    SDI_TRIS = 1;   // SDI
    CS_TRIS = 0;            // CS

    CS_PIN = 1;     // CS idle high
    
    SSPSTATbits.SMP = 0;    //Sample the input at middle of data output time
    SSPSTATbits.CKE = 1;    //Transmit occurs on active->idle clock state (high->low)

    SSPCON1bits.CKP  = 0;   //Idle state for clock is low level
    SSPCON1bits.SSPM = 0b0001;   // Master, Fosc/16 = 4MHz
    SSPCON1bits.SSPEN = 1;  //Enable serial port (SCK,SDO,SDI)
}

