/*Envelope stuff*/
#define ENV_IDLE     0
#define ENV_ATTACK   1
#define ENV_DECAY    2
#define ENV_SUSTAIN  3
#define ENV_RELEASE  4

volatile uint8_t env_level = 0;        // 0=silent, 255=full volume
volatile uint8_t env_state = ENV_IDLE; // current envelope stage

volatile uint8_t attack_step = 1;      // bigger = faster attack
volatile uint8_t decay_step  = 1;      // bigger = faster decay
volatile uint8_t release_step = 1;       // Bigger = faster release
volatile uint8_t sustain_level = 160;    // Held volume after decay, 0-255

volatile uint8_t env_tick_flag = 0;

void note_on(uint8_t note_index){
    phase_incr = note_phase_incr[note_index]; // Set the pitch of the note
    phase_accum = 0;                          // Restart waveform from beginning
    //env_level = 0;                            // Start envelope at silence
    env_state = ENV_ATTACK;                   // Start attack mode
}
void note_off(void){
    env_state = ENV_RELEASE;    //Begin fade-out
}
void envelope_update(void){
    switch(env_state){

        case ENV_ATTACK:
            if (env_level + attack_step >= 255){
                env_level = 255;
                env_state = ENV_DECAY;
            } else {
                env_level += attack_step;
            }
            break;

        case ENV_DECAY:
            if (env_level <= sustain_level + decay_step){
                env_level = sustain_level;
                env_state = ENV_SUSTAIN;
            } else {
                env_level -= decay_step;
            }
            break;

        case ENV_SUSTAIN:
            env_level = sustain_level;
            break;

        case ENV_RELEASE:
            if (env_level <= release_step){
                env_level = 0;
                env_state = ENV_IDLE;
            } else {
                env_level -= release_step;
            }
            break;

        case ENV_IDLE:
        default:
            env_level = 0;
            break;
    }
}

