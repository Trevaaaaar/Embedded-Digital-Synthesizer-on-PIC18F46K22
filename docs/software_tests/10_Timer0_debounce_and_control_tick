// LFO DDS
volatile uint32_t lfo_phase_accum = 0;
// lfo_phase_incr = LFO_freq * 2^32 / SAMPLE_RATE
// For 5 Hz at 10 kHz sample rate:
// 5 * 4294967296 / 10000 = 2147483
volatile uint32_t lfo_phase_incr = 858993UL; //2Hz LFO =========
// Tremolo depth: 0-255.0 = no tremolo, 255 = extreme tremolo.
volatile uint8_t tremolo_depth = 150; //volume percentage to oscillate =====

// ===============================================================
/*TMR0 debouncing and button matrix*/
volatile uint8_t control_tick_flag = 0; //for timer0

#define DEBOUNCE_MS 20

volatile uint8_t rc0_cnt = 0, rc1_cnt = 0, rd0_cnt = 0;
volatile uint8_t rc0_state = 1, rc1_state = 1, rd0_state = 1;
volatile uint8_t rc0_last  = 1, rc1_last  = 1, rd0_last  = 1;

volatile uint8_t rc0_event = 0;
volatile uint8_t rc1_event = 0;
volatile uint8_t rd0_event = 0;

void timer0_init(void){     //~1ms interrupt
    INTCONbits.TMR0IE = 1;  //Enable TMR0 interrupts
    INTCONbits.TMR0IF = 0;  //Clear TMR0 flag
    T0CONbits.TMR0ON = 0;   // Stop Timer0 during setup
    T0CONbits.T08BIT = 0;   // 0 = 16-bit timer
    T0CONbits.T0CS = 0;     // 0 = internal clock
    T0CONbits.PSA = 0;      // 0 = prescaler assigned
    T0CONbits.T0PS = 0b100; // 1:32
    // Preload for 1 ms overflow
    TMR0H = 0xFE; //Timer tick = 62.5 ns × 32 = 2 µs
    TMR0L = 0x0C; //1 ms / 2 µs = 500 counts
                  //65536 - 500 = 65036 = 0xFE0C
    T0CONbits.TMR0ON = 1; //Start timer
}

#define NO_KEY 0xFF
uint8_t scan_matrix_2x2(void){
    LATBbits.LATB0 = 0;
    LATBbits.LATB1 = 1;
    __delay_us(5);

    if (!PORTBbits.RB2) { LATBbits.LATB0 = 1; return 0; }
    if (!PORTBbits.RB3) { LATBbits.LATB0 = 1; return 1; }

    LATBbits.LATB0 = 1;
    LATBbits.LATB1 = 0;
    __delay_us(5);

    if (!PORTBbits.RB2) { LATBbits.LATB1 = 1; return 2; }
    if (!PORTBbits.RB3) { LATBbits.LATB1 = 1; return 3; }

    LATBbits.LATB0 = 1;
    LATBbits.LATB1 = 1;
    return NO_KEY;
}
// ===============================================================

void timer2_init(void){
    INTCONbits.GIE = 1;     // Enable global interrupts
    INTCONbits.PEIE = 1;    // Enable peripheral interrupts
    PIE1bits.TMR2IE = 1;    // Enable TMR2 interrupts
    
    PIR1bits.TMR2IF = 0;    // Clear TMR2 flag
    T2CONbits.TMR2ON = 0;   // Turn off TMR2 while configuring
    TMR2 = 0;               // Clear TMR2
    /*
       Fosc = 64 MHz
       Instruction clock = Fosc / 4 = 16 MHz
       Timer tick with prescaler 16 = 1 us

       For 10 kHz sample rate: sample period = 100 us
       Timer2 period = (PR2 + 1) * prescaler * instruction_cycle
                    = (99 + 1) * 16 * 62.5 ns = 100us
    */
    PR2 = 99;
    T2CONbits.T2CKPS = 0b10;    //prescale 1:16
    T2CONbits.T2OUTPS = 0b0000; //postscale 1:1
    T2CONbits.TMR2ON = 1;       //start timer2
}

void main(void){
    ANSELA = 0x00;
    ANSELC = 0x00;
    ANSELD = 0x00;
    OSCCON  = 0b01110000;
    OSCTUNE = 0b01000000;
    
    TRISCbits.TRISC0 = 1; //C0 button input for volume change
    TRISCbits.TRISC1 = 1; //C1 button input for wave type change
    TRISDbits.TRISD0 = 1; //D0 button for ...
    
    ANSELB = 0x00;

    TRISBbits.TRISB0 = 0;
    TRISBbits.TRISB1 = 0;
    TRISBbits.TRISB2 = 1;
    TRISBbits.TRISB3 = 1;

    INTCON2bits.RBPU = 0;
    WPUBbits.WPUB2 = 1;
    WPUBbits.WPUB3 = 1;

    LATBbits.LATB0 = 1;
    LATBbits.LATB1 = 1;

    SPI_init();
    timer2_init();
    timer0_init();
    __delay_ms(10);
    
    while(1) {
        
        uint8_t key = scan_matrix_2x2();

        if (key != NO_KEY) {
            __delay_ms(20);              // debounce

            if (scan_matrix_2x2() == key) {
                phase_incr = note_phase_incr[key];

                while (scan_matrix_2x2() == key);
                __delay_ms(20);
            }
        }
        
        if (env_tick_flag) {
            env_tick_flag = 0;
            envelope_update();
        }
        if (rc0_event) {
            rc0_event = 0;
            volume_index = (volume_index + 1) % NUM_VOLUME_LEVELS;
            volume = volume_levels[volume_index];
        }

        if (rc1_event) {
            rc1_event = 0;
            wave_type_index = (wave_type_index + 1) % 4;
        }

        if (rd0_event) {
            rd0_event = 0;
            note_on(3);
        }

        if (rd0_state == 1 && env_state != ENV_IDLE && env_state != ENV_RELEASE) {
            note_off();
        }
    }
}

void __interrupt() ISR(void){
    
    uint16_t sample_val = 0;
    uint16_t dac_output = 0; //volume
    
    if (PIR1bits.TMR2IF){
        PIR1bits.TMR2IF = 0;    //Clear tmr2 interrupt flag
        //DDS step 1: advance phase by phase increment
        lfo_phase_accum += lfo_phase_incr;
        phase_accum += phase_incr;

        //DDS step 2: assign wave sample value
        uint8_t sine_index;
        uint16_t sample_val;

        switch (wave_type_index){
            case SINE_WAVE: 
                sine_index = (uint8_t)(phase_accum >> PHASE_SHIFT);
                sample_val = sine_table[sine_index];
                break;

            case SQUARE_WAVE:
                sample_val = (phase_accum & 0x80000000) ? 4095 : 0;
                break;

            case SAWTOOTH_WAVE: 
                sample_val = phase_accum >> 20;
                break;

            case TRIANGLE_WAVE:
                if (phase_accum & 0x80000000) {
                    sample_val = 4095 - ((phase_accum >> 19) & 0x0FFF);
                } else {
                    sample_val = (phase_accum >> 19) & 0x0FFF;
                }
                break;

            default:
                sine_index = (uint8_t)(phase_accum >> PHASE_SHIFT);
                sample_val = sine_table[sine_index];
                break;
        }
        
        // *** VOLUME CHANGE ***
        // OPTIMIZED: compute tremolo gain once using the LFO phase.
        // This avoids a function call and avoids reading the LFO table twice.
        uint8_t lfo_index = (uint8_t)(lfo_phase_accum >> PHASE_SHIFT);
        int8_t lfo_signed = lfo_sine_table[lfo_index];     // -127 to +127

        // convert -127..+127 into 0..254-ish
        uint16_t lfo_0_255 = (uint16_t)((int16_t)lfo_signed + 127);

        // trem_gain = 255 when depth = 0
        // deeper tremolo follows the LFO more strongly
        uint16_t trem_gain = 255 - (((uint16_t)tremolo_depth * (255 - lfo_0_255)) >> 8);

        uint16_t env_trem_gain = ((uint16_t)env_level * trem_gain) >> 8;
        uint16_t total_gain = ((uint16_t)volume * env_trem_gain) >> 8;

        // Only one final audio multiply.
        int32_t centered = (int32_t)sample_val - 2048;
        int32_t final_vol = (centered * total_gain) >> 8;

        dac_output = (uint16_t)(2048 + final_vol);
        
        //DDS step 3: send sample to DAC
        mcp4822_write(DAC_CHAN_A, GAIN_1X, dac_output);
    }
    //==============================================
    //TRM0 slower stuff
    if (INTCONbits.TMR0IF) {
        INTCONbits.TMR0IF = 0;

        // Reload for next 1 ms
        TMR0H = 0xFE;
        TMR0L = 0x0C;

        // Set flag ONLY (keep ISR fast)
        control_tick_flag = 1;
        env_tick_flag = 1;
        
        uint8_t raw;

        // ---------- RC0 ----------
        raw = PORTCbits.RC0;

        if (raw == rc0_last) {                      //if current input matches previous input (hold or released)
            if (rc0_cnt < DEBOUNCE_MS) rc0_cnt++;   //then if counter less than 20ms, increment (detect hold for 20ms)
            else if (rc0_state != raw) {            //then if current state var does not equal current input,
                rc0_state = raw;                    //update current state
                if (rc0_state == 0) rc0_event = 1;  //if current state is button press, event happens
            }       //so: if button held for 20ms, set event equal to 1, and don't update cuz state = current input
        } else {            //otherwise
            rc0_cnt = 0;    //reset counter
            rc0_last = raw; //update previous input with current input
        }

        // ---------- RC1 ----------
        raw = PORTCbits.RC1;

        if (raw == rc1_last) {
            if (rc1_cnt < DEBOUNCE_MS) rc1_cnt++;
            else if (rc1_state != raw) {
                rc1_state = raw;
                if (rc1_state == 0) rc1_event = 1;
            }
        } else {
            rc1_cnt = 0;
            rc1_last = raw;
        }

        // ---------- RD0 ----------
        raw = PORTDbits.RD0;

        if (raw == rd0_last) {
            if (rd0_cnt < DEBOUNCE_MS) rd0_cnt++;
            else if (rd0_state != raw) {
                rd0_state = raw;
                if (rd0_state == 0) rd0_event = 1;
            }
        } else {
            rd0_cnt = 0;
            rd0_last = raw;
        }
    }
}
