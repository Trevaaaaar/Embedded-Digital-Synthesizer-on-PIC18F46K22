uint8_t edit_btn_state = 1;
uint8_t edit_btn_last = 1;
uint8_t edit_btn_event = 0;

uint8_t lcd_update_counter = 0;

void debounce_button(uint8_t raw,
                     uint8_t *last,
                     uint8_t *cnt,
                     uint8_t *state,
                     uint8_t *event)
{
    if (raw == *last) {
        if (*cnt < DEBOUNCE_MS) {
            (*cnt)++;
        }
        else if (*state != raw) {
            *state = raw;
            if (*state == 0) {
                *event = 1;
            }
        }
    }
    else {
        *cnt = 0;
        *last = raw;
    }
}

// ===============================================================
/* Controls update */

void controls_update(void)
{
    uint16_t pot0;
    uint16_t pot1;

    debounce_button(PORTCbits.RC6,
                    &screen_btn_last,
                    &screen_btn_cnt,
                    &screen_btn_state,
                    &screen_btn_event);

    debounce_button(PORTCbits.RC7,
                    &edit_btn_last,
                    &edit_btn_cnt,
                    &edit_btn_state,
                    &edit_btn_event);

    if (screen_btn_event) {
        screen_btn_event = 0;

        screen++;
        if (screen >= NUM_SCREENS) screen = 0;

        edit_mode = 0;
        LCD_clear();
        lcd_dirty = 1;
    }

    if (edit_btn_event) {
        edit_btn_event = 0;

        edit_mode = !edit_mode;
        LCD_clear();
        lcd_dirty = 1;
    }

    if (edit_mode) {
        pot0 = read_ADC(0);
        pot1 = read_ADC(1);

        switch (screen) {
            case 0: {
                current_note_profile.volume = adc_to_u8(pot0);                                       //VOL 0-256
                current_note_profile.wave_type = adc_to_wave(pot1);                            //WAVE INDEX
                break;
            }
            case 1: {
                current_note_profile.attack_ms = adc_to_ms(pot0);                              //ATTACK MS 0-256
                current_note_profile.decay_ms = adc_to_ms(pot1);                              //DECAY MS 0-256

                update_envelope_steps();   
                
                display_attack = current_note_profile.attack_ms;
                display_decay  = current_note_profile.decay_ms;
                break;
            }
            case 2:{
                display_sustain = adc_to_percent(pot0);
                current_note_profile.sustain_level = (uint8_t)((display_sustain * 255UL) / 100UL);   //SUSTSAIN 0-256

                current_note_profile.release_ms = adc_to_ms(pot1);                              //RELEASE MS 0-256

                update_envelope_steps();
                display_release = current_note_profile.release_ms;
                break;
            }
            case 3:{
                display_tremolo = adc_to_percent(pot0);
                current_note_profile.tremolo_depth = (uint8_t)((display_tremolo * 255UL) / 100UL);   //TREM DEPTH 0-256

                note_index = adc_to_note_index(pot1);                           // CHANGE: pot1 selects pitch C4-C5
                current_note_profile.pitch = note_phase_incr[note_index];       // CHANGE: update pitch immediately
                phase_incr = current_note_profile.pitch; 

                break;
            }
        }

        lcd_dirty = 1;
    }
}

void lcd_draw(void)
{
    LCD_cursor_set(1,1);
    LCD_write_string("                ");
    LCD_cursor_set(1,1);
    LCD_write_string(paramLabels[screen][0]);
    LCD_write_string(":");

    switch (screen) {
        case 0:
            LCD_write_variable(adc_to_percent((uint16_t)current_note_profile.volume << 2), 0);
            LCD_write_string("%");
            break;

        case 1:
            LCD_write_variable(display_attack, 0);
            LCD_write_string("ms");
            break;

        case 2:
            LCD_write_variable(display_sustain, 0);
            LCD_write_string("%");
            break;

        case 3:
            LCD_write_variable(display_tremolo, 0);
            LCD_write_string("%");
            break;
    }

    LCD_cursor_set(2,1);
    LCD_write_string("                ");
    LCD_cursor_set(2,1);
    LCD_write_string(paramLabels[screen][1]);
    LCD_write_string(":");

    switch (screen) {
        case 0:
            LCD_write_string(waveNames[current_note_profile.wave_type]);
            break;

        case 1:
            LCD_write_variable(display_decay, 0);
            LCD_write_string("ms");
            break;

        case 2:
            LCD_write_variable(display_release, 0);
            LCD_write_string("ms");
            break;

        case 3:
            LCD_write_string(noteNames[note_index]);                        // CHANGE: show selected note instead of :)
            break;
    }

    LCD_cursor_set(1,15);
    if (edit_mode) LCD_write_string("E");
    else LCD_write_string(" ");
}

// ===============================================================
/* Envelope helpers*/

void note_on(uint8_t note_index)
{
    current_note_profile.pitch = note_phase_incr[note_index];
    phase_incr = current_note_profile.pitch;
    phase_accum = 0;
    env_state = ENV_ATTACK;
}

void note_off(void)
{
    env_state = ENV_RELEASE;
}

void envelope_update(void)
{
    switch (env_state) {
        case ENV_ATTACK:
            if (env_level + attack_step >= 255) {
                env_level = 255;
                env_state = ENV_DECAY;
            } else {
                env_level += attack_step;
            }
            break;

        case ENV_DECAY:
            if (env_level <= current_note_profile.sustain_level + decay_step) {
                env_level = current_note_profile.sustain_level;
                env_state = ENV_SUSTAIN;
            } else {
                env_level -= decay_step;
            }
            break;

        case ENV_SUSTAIN:
            env_level = current_note_profile.sustain_level;
            break;

        case ENV_RELEASE:
            if (env_level <= release_step) {
                env_level = 0;
                env_state = ENV_IDLE;
            } else {
                env_level -= release_step;
            }
            break;

        case ENV_IDLE:
        default:
            env_level = 0;
            break;
    }
}

// ===============================================================
/* Main */

void main(void)
{
    ANSELA = 0x00;
    ANSELB = 0x00;
    ANSELC = 0x00;
    ANSELD = 0x00;
    ANSELE = 0x00;

    OSCCON = 0b01110000;
    OSCTUNE = 0b01000000;

    TRISDbits.TRISD0 = 1; // note button

    TRISCbits.TRISC6 = 1; // screen button
    TRISCbits.TRISC7 = 1; // edit button
    ANSELCbits.ANSC6 = 0;
    ANSELCbits.ANSC7 = 0;

    LCD_init();
    LCD_clear();

    ADC_init();
    SPI_init();
    timer2_init();
    timer0_init();
    
    update_envelope_steps();
    current_note_profile.pitch = note_phase_incr[note_index];
    phase_incr = current_note_profile.pitch;
    __delay_ms(10);

    lcd_draw();

    while (1) {
        if (env_tick_flag) {
            env_tick_flag = 0;
            envelope_update();                                                  //progress
        }

        if (rd0_event) {
            rd0_event = 0;
            note_on(note_index);                                            // CHANGE: use selected pitch instead of fixed note_on(3)
        }

        if (rd0_state == 1 &&
            env_state != ENV_IDLE &&
            env_state != ENV_RELEASE) {
            note_off();
        }

        if (control_tick_flag) {
            control_tick_flag = 0;

            controls_update();

            lcd_update_counter++;
            if (lcd_update_counter >= LCD_UPDATE_MS) {
                lcd_update_counter = 0;

                if (lcd_dirty) {
                    lcd_dirty = 0;
                    lcd_draw();
                }
            }
        }
    }
}

// ===============================================================
/* ISR */

void __interrupt() ISR(void)
{
    if (PIR1bits.TMR2IF) {
        PIR1bits.TMR2IF = 0;

        uint8_t sine_index;
        uint16_t sample_val;
        uint16_t dac_output;

        lfo_phase_accum += lfo_phase_incr;
        phase_accum += phase_incr;

        switch (current_note_profile.wave_type) {
            case SINE_WAVE:
                sine_index = (uint8_t)(phase_accum >> PHASE_SHIFT);
                sample_val = sine_table[sine_index];
                break;

            case SQUARE_WAVE:
                sample_val = (phase_accum & 0x80000000) ? 4095 : 0;
                break;

            case SAWTOOTH_WAVE:
                sample_val = phase_accum >> 20;
                break;

            case TRIANGLE_WAVE:
                if (phase_accum & 0x80000000) {
                    sample_val = 4095 - ((phase_accum >> 19) & 0x0FFF);
                } else {
                    sample_val = (phase_accum >> 19) & 0x0FFF;
                }
                break;

            default:
                sine_index = (uint8_t)(phase_accum >> PHASE_SHIFT);
                sample_val = sine_table[sine_index];
                break;
        }

        uint8_t lfo_index = (uint8_t)(lfo_phase_accum >> PHASE_SHIFT);
        int8_t lfo_signed = lfo_sine_table[lfo_index];

        uint16_t lfo_0_255 = (uint16_t)((int16_t)lfo_signed + 127);
        uint16_t trem_gain = 255 - (((uint16_t)current_note_profile.tremolo_depth * (255 - lfo_0_255)) >> 8);

        uint16_t env_trem_gain = ((uint16_t)env_level * trem_gain) >> 8;
        uint16_t total_gain = ((uint16_t)current_note_profile.volume * env_trem_gain) >> 8;

        int32_t centered = (int32_t)sample_val - 2048;
        int32_t final_vol = (centered * total_gain) >> 8;

        dac_output = (uint16_t)(2048 + final_vol);

        mcp4822_write(DAC_CHAN_A, GAIN_1X, dac_output);
    }

    if (INTCONbits.TMR0IF) {
        INTCONbits.TMR0IF = 0;

        TMR0H = 0xFE;
        TMR0L = 0x0C;

        control_tick_flag = 1;
        env_tick_flag = 1;

        uint8_t raw = PORTDbits.RD0;

        if (raw == rd0_last) {
            if (rd0_cnt < DEBOUNCE_MS) {
                rd0_cnt++;
            }
            else if (rd0_state != raw) {
                rd0_state = raw;
                if (rd0_state == 0) {
                    rd0_event = 1;
                }
            }
        }
        else {
            rd0_cnt = 0;
            rd0_last = raw;
        }
    }
}
