// ===============================================================
/*SPI / DAC */
#define CS_PIN      LATCbits.LATC2
#define CS_TRIS     TRISCbits.TRISC2
#define SCK_TRIS    TRISCbits.TRISC3
#define SDI_TRIS    TRISCbits.TRISC4
#define SDO_TRIS    TRISCbits.TRISC5

// MCP4822 channel select bit (bit 15 of the 16-bit command word)
#define DAC_CHAN_A  0
#define DAC_CHAN_B  1
#define GAIN_2X     0
#define GAIN_1X     1

void mcp4822_write(uint8_t channel, uint8_t gain, uint16_t code)
{
    uint16_t cmd = 0;

    cmd |= ((uint16_t)(channel & 0x01)) << 15;
    cmd |= ((uint16_t)(gain & 0x01)) << 13;
    cmd |= (1u << 12);
    cmd |= (code & 0x0FFF);

    CS_PIN = 0;

    SSPBUF = (uint8_t)(cmd >> 8);
    while (!SSPSTATbits.BF);
    (void)SSPBUF;

    SSPBUF = (uint8_t)(cmd & 0xFF);
    while (!SSPSTATbits.BF);
    (void)SSPBUF;

    CS_PIN = 1;
}

void SPI_init(void)
{
    SCK_TRIS = 0;
    SDO_TRIS = 0;
    SDI_TRIS = 1;
    CS_TRIS = 0;

    CS_PIN = 1;

    SSPSTATbits.SMP = 0;
    SSPSTATbits.CKE = 1;

    SSPCON1bits.CKP = 0;
    SSPCON1bits.SSPM = 0b0001; // Fosc / 16 = 4 MHz
    SSPCON1bits.SSPEN = 1;
}

