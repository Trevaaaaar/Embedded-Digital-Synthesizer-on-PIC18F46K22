/* ADC */

void ADC_init(void)
{
    ANSELA = 0x00;
    ANSELB = 0x00;
    ANSELC = 0x00;
    ANSELD = 0x00;
    ANSELE = 0x00;

    ANSELAbits.ANSA0 = 1;
    ANSELAbits.ANSA1 = 1;

    TRISAbits.TRISA0 = 1;
    TRISAbits.TRISA1 = 1;

    CM1CON0bits.C1ON = 0;
    CM2CON0bits.C2ON = 0;

    ADCON0 = 0b00000001;
    ADCON1 = 0b00000000;
    ADCON2 = 0b10111111;
}

uint16_t read_ADC(uint8_t channel)
{
    ADCON0bits.CHS = channel;
    ADCON0bits.ADON = 1;

    __delay_us(200);

    ADCON0bits.GO_nDONE = 1;
    while (ADCON0bits.GO_nDONE);

    return ((uint16_t)ADRESH << 8) | ADRESL;
}

uint8_t adc_to_u8(uint16_t adc)
{
    return (uint8_t)(adc >> 2);
}

uint8_t adc_to_percent(uint16_t adc)
{
    return (uint8_t)((adc * 100UL) / 1023UL);
}

uint8_t adc_to_wave(uint16_t adc)
{
    if (adc < 256) return SINE_WAVE;
    if (adc < 512) return SQUARE_WAVE;
    if (adc < 768) return SAWTOOTH_WAVE;
    return TRIANGLE_WAVE;
}

uint16_t adc_to_ms(uint16_t adc)
{
    return 1 + ((uint32_t)adc * 254UL) / 1023UL;  // 1?255 ms
}

// CHANGE: converts ADC value into 13 pitch steps, index 0-12
uint8_t adc_to_note_index(uint16_t adc){
    return (uint8_t)(((uint32_t)adc * 13UL) / 1024UL);
}

