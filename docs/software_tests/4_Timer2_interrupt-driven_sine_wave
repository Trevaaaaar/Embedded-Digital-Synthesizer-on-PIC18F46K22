#include <xc.h>
#include <stdint.h>
#include <math.h>
#include "PIC18F46K22-Config.h"

#define _XTAL_FREQ 64000000UL
// ---------- Pin aliases ----------
#define CS_PIN      LATCbits.LATC2
#define CS_TRIS     TRISCbits.TRISC2
#define SCK_TRIS    TRISCbits.TRISC3
#define SDI_TRIS    TRISCbits.TRISC4
#define SDO_TRIS    TRISCbits.TRISC5

// MCP4822 channel select bit (bit 15 of the 16-bit command word)
#define DAC_CHAN_A  0
#define DAC_CHAN_B  1
#define GAIN_2X     0   // bit=0 → 2x gain
#define GAIN_1X     1   // bit=1 → 1x gain

#define SINE_N      64
uint16_t sine_table[SINE_N];
uint8_t sine_index = 0;

void mcp4822_write(uint8_t channel, uint8_t gain, uint16_t code){
    // Build 16-bit command word
    // Bit 15:   channel select (0=A, 1=B)
    // Bit 14:   don't care (0)
    // Bit 13:   /GA gain (0=2x, 1=1x)
    // Bit 12:   /SHDN (1=active)
    // Bits 11-0: 12-bit data
    uint16_t cmd = 0;
    cmd |= ((uint16_t)(channel & 0x01)) << 15;  // Set CHA or CHB
    cmd |= ((uint16_t)(gain    & 0x01)) << 13;  // Set GAIN
    cmd |= (1u << 12);                          // /SHDN = 1 (active)
    cmd |= (code & 0x0FFF);                     // 

    CS_PIN = 0;                                 // assert /CS
    
    SSPBUF = (uint8_t)(cmd >> 8); //Send high byte of SPI command
    while(!SSPSTATbits.BF);         //Wait till done sending
    (void)SSPBUF;                   //Clears SSPSTATbits.BF by reading the received data (which we ignore)
    SSPBUF = (uint8_t)(cmd & 0xFF); //Send low byte of SPI command
    while(!SSPSTATbits.BF);         
    SSPSTATbits.BF = 0;
    (void)SSPBUF;
    
    CS_PIN = 1;                                 // deassert /CS — latches output
}
void mcp4822_set_mv(uint8_t channel, uint16_t millivolts){
    // Clamp to 4095 max (just under 4096 mV with 2x gain)
    if (millivolts > 4095) millivolts = 4095;
    mcp4822_write(channel, GAIN_1X, (uint16_t)millivolts);
}

void SPI_init(void){
    SCK_TRIS = 0;   // SCK
    SDO_TRIS = 0;   // SDO
    SDI_TRIS = 1;   // SDI
    CS_TRIS = 0;            // CS

    CS_PIN = 1;     // CS idle high
    
    SSPSTATbits.SMP = 0;    //Sample the input at middle of data output time
    SSPSTATbits.CKE = 1;    //Transmit occurs on active->idle clock state (high->low)

    SSPCON1bits.CKP  = 0;   //Idle state for clock is low level
    SSPCON1bits.SSPM = 0b0010;   // Master, Fosc/64 = 1mHz
    SSPCON1bits.SSPEN = 1;  //Enable serial port (SCK,SDO,SDI)
}

// Build lookup table once at startup
// sin() returns -1.0 to +1.0
// Shift to 0.0–2.0, scale to 0–4095
void sine_table_init(void){
    uint8_t i;
    for (i = 0; i < SINE_N; i++) {
        sine_table[i] = (uint16_t)((sin(2.0 * 3.14159265 * i / SINE_N) + 1.0) * 2047.5);
    }
}

void timer2_init(void){
    INTCONbits.GIE = 1;     // Enable global interrupts
    INTCONbits.PEIE = 1;    // Enable peripheral interrupts
    PIE1bits.TMR2IE = 1;    // Enable TMR2 interrupts
    
    PIR1bits.TMR2IF = 0;    // Clear TMR2 flag
    T2CONbits.TMR2ON = 0;   // Turn off TMR2 while configuring
    TMR2 = 0;               // Clear TMR2
    
    //at 64Mhz, inst cycle period = 62.5ns
    //PR2 tick rate w max post and pre scale = 62.5ns * 16Post * 16Pre = 16us
    //max delay w timer2 = 16us(PR2 tick rate) * 256PR2 = 4.096ms
    PR2 = 34;                   //overflow every 35us, 64Mhz and 16 prescale
    T2CONbits.T2CKPS = 0b10;    //prescale 1:16
    T2CONbits.T2OUTPS = 0b0000; //postscale 1:1
    T2CONbits.TMR2ON = 1;       //start timer2
}
void main(void)
{
    ANSELA = 0x00;
    ANSELC = 0x00;
    OSCCON  = 0b01110000;
    OSCTUNE = 0b01000000;

    SPI_init();
    sine_table_init();
    timer2_init();
    __delay_ms(10);

    //==============================================
    // Testing Square Wave at 440Hz (per = 2272us)
    while(1) 
    {
        ;
    }
}

void __interrupt() ISR(void){
    PIR1bits.TMR2IF = 0;    //Clear tmr2 interrupt flag
    
    // Output current sample from the sine table to DAC channel A, 1x gain
    mcp4822_write(DAC_CHAN_A, GAIN_1X, sine_table[sine_index]);
    
    // Advance to next sample, wrap back to 0 after 63
    sine_index = (sine_index + 1) % SINE_N;
}
